# ===========================================================================
# Tess · LLM 后端配置（OpenAI 兼容协议，已按 DeepSeek 填好默认值）
# 用法：复制为 .env，只改 TESS_LLM_API_KEY 即可。
# ===========================================================================

# LLM 网关地址（DeepSeek OpenAI 兼容端点，无需改动）
TESS_LLM_BASE_URL=https://api.deepseek.com

# 【必填】你的 DeepSeek API Key（https://platform.deepseek.com → API Keys）
TESS_LLM_API_KEY=sk-your-deepseek-key

# 模型名：deepseek-chat = V3（默认，JSON 输出稳定、便宜、快）
#         deepseek-reasoner = R1（推理更强但更慢，且会带 reasoning 字段，
#         本场景建议用 deepseek-chat）
TESS_LLM_MODEL=deepseek-chat

# （可选）Tess 诊断 API 监听端口
TESS_API_PORT=8080

# （可选）API 访问密钥 —— 留空=开发模式（不鉴权，测试前端照常可用）；
#   生产期填一个强随机值后，所有 /tess/* 接口将强制要求请求头 X-API-Key 匹配，否则 401。
#   改完后需 `docker compose up -d` 让新值生效。前端「API Key」框填入同一值即可。
TESS_API_KEY=

# ===========================================================================
# P5 · 数据接入层（Tess 主动拉取 Teensing 真实异常数据，可选）
# 默认 mock：部署后用 GET /tess/diagnose-from-source 即可拉取内置样例并诊断，
#   无需任何外部配置，适合开发/演示。
# 生产接真实数据：设 TESS_DATA_CONNECTOR=teensing + 下方变量，再调同一端点。
# ===========================================================================

# 数据接入实现：mock（默认，零配置）| teensing（生产，拉取真实异常数据 API）
TESS_DATA_CONNECTOR=mock

# Teensing 异常数据 API 根地址（TESS_DATA_CONNECTOR=teensing 时必填）
# 例如 https://api.teensing.com/v1
TESS_DATA_API_BASE_URL=

# Teensing 数据 API 鉴权 Token（Bearer），留空则不带鉴权头
TESS_DATA_API_KEY=

# 请求超时（秒，默认 10）
TESS_DATA_API_TIMEOUT=10

