# ===========================================================================
# Tess · LLM 后端配置（OpenAI 兼容协议，已按 DeepSeek 填好默认值）
# 用法：复制为 .env，只改 TESS_LLM_API_KEY 即可。
# ===========================================================================

# LLM 网关地址（DeepSeek OpenAI 兼容端点，无需改动）
TESS_LLM_BASE_URL=https://api.deepseek.com

# 【必填】你的 DeepSeek API Key（https://platform.deepseek.com → API Keys）
TESS_LLM_API_KEY=sk-your-deepseek-key

# 模型名：deepseek-chat = V3（默认，JSON 输出稳定、便宜、快）
#         deepseek-reasoner = R1（推理更强但更慢，且会带 reasoning 字段，
#         本场景建议用 deepseek-chat）
TESS_LLM_MODEL=deepseek-chat

# （可选）Tess 诊断 API 监听端口
TESS_API_PORT=8080
