# ===========================================================================
# Tess · LLM 后端配置（OpenAI 兼容协议，已按 DeepSeek 填好默认值）
# 用法：复制为 .env，只改 TESS_LLM_API_KEY 即可。
# ===========================================================================

# LLM 网关地址（DeepSeek OpenAI 兼容端点，无需改动）
TESS_LLM_BASE_URL=https://api.deepseek.com

# 【必填】你的 DeepSeek API Key（https://platform.deepseek.com → API Keys）
TESS_LLM_API_KEY=sk-your-deepseek-key

# 模型名：deepseek-chat = V3（默认，JSON 输出稳定、便宜、快）
#         deepseek-reasoner = R1（推理更强但更慢，且会带 reasoning 字段，
#         本场景建议用 deepseek-chat）
TESS_LLM_MODEL=deepseek-chat

# （可选）Tess 诊断 API 监听端口
TESS_API_PORT=8080

# （可选）API 访问密钥 —— 留空=开发模式（不鉴权，测试前端照常可用）；
#   生产期填一个强随机值后，所有 /tess/* 接口将强制要求请求头 X-API-Key 匹配，否则 401。
#   改完后需 `docker compose up -d` 让新值生效。前端「API Key」框填入同一值即可。
TESS_API_KEY=

# ===========================================================================
# P5 · 数据接入层（Tess 主动拉取 Teensing 真实异常数据，可选）
# 默认 mock：部署后用 GET /tess/diagnose-from-source 即可拉取内置样例并诊断，
#   无需任何外部配置，适合开发/演示。
# 生产接真实数据：设 TESS_DATA_CONNECTOR=teensing + 下方变量，再调同一端点。
# ===========================================================================

# 数据接入实现：mock（默认，零配置）| teensing（生产，拉取真实异常数据 API）
TESS_DATA_CONNECTOR=mock

# Teensing 异常数据 API 根地址（TESS_DATA_CONNECTOR=teensing 时必填）
# 需含 /api/v1 前缀，例：https://saas.teensing.com/api/v1
TESS_DATA_API_BASE_URL=

# Teensing 数据 API 兜底 Token（Bearer）—— 多数场景留空。
# 生产推荐做法：token 不落库，由调用 Tess 的前端在请求头 X-Teensing-Token 传入
#   当前运营（已登录 SaaS）的 access_token，Tess 原样透传给 Teensing；
#   Teensing 按该运营的 RBAC/数据权限返回数据（实现「按访问者权限回数据」）。
# 仅当无前端透传、需要做服务端固定凭据调用时才填这里。
TESS_DATA_API_KEY=

# 请求超时（秒，默认 10）
TESS_DATA_API_TIMEOUT=10

# ===========================================================================
# P6 · 问答审计日志（记录每个运营的「问题 + Tess 回答」，本地 SQLite）
# ===========================================================================

# 审计库文件路径（默认 tess_audit.db，落在本服务工作目录）
TESS_AUDIT_DB=tess_audit.db

# ===========================================================================
# P6 · 调用方请求头约定（前端/SaaS 调 Tess 时携带）
# ===========================================================================
# X-Operator-Id   : 当前运营标识（用于审计归因，缺省记 anonymous）
# X-Teensing-Token: 当前运营的 SaaS access_token（teensing 生产模式必带，用于按权限拉数据）
# 二者由 SaaS 前端在调用 Tess 时一并带上即可。

# ===========================================================================
# P7 · 定时预警调度（Tess 自己每小时跑，前端不必点按钮）
# 启用后 Tess 在进程内每小时自动：拉异常 → 诊断 → 存预警库；
# Teensing / SaaS 后端用 GET /tess/alerts 轮询拉取结果（推送飞书等以后再加）。
# 鉴权：按你的选择用「共享服务 token、不按人过滤」。
# ===========================================================================

# 是否启用定时调度（默认 false；置 1/true/yes/on 即开启每小时自动诊断）
TESS_SCHEDULE_ENABLED=false

# 调度间隔（秒，默认 3600 = 1 小时）
TESS_SCHEDULE_INTERVAL=3600

# 每轮拉取异常数（默认 20）
TESS_SCHEDULE_LIMIT=20

# 定时任务使用的共享服务 token（Bearer）。留空则回退 TESS_DATA_API_KEY。
# 即「一个共享账号 token 拉全量异常」，不做按运营权限隔离。
TESS_SYSTEM_TOKEN=

# 预警库文件路径（默认 tess_alerts.db，落在本服务工作目录）
TESS_ALERTS_DB=tess_alerts.db


